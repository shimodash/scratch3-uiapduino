.vscode/
.DS_Store

!.gitignore
!README.md

# 上流リポジトリに被せるファイルだけを追跡する（ホワイトリスト方式）。
# ビルド時に clone される scratch-vm / scratch-gui / scratch-desktop の
# 本体は追跡しない。

/scratch-vm/*
!/scratch-vm/LICENSE
!/scratch-vm/src
/scratch-vm/src/*
!/scratch-vm/src/extensions
/scratch-vm/src/extensions/*
!/scratch-vm/src/extensions/scratch3_uiapduino
!/scratch-vm/src/extension-support
/scratch-vm/src/extension-support/*
!/scratch-vm/src/extension-support/extension-manager.js

/scratch-gui/*
!/scratch-gui/LICENSE
!/scratch-gui/src
/scratch-gui/src/*
!/scratch-gui/src/lib
/scratch-gui/src/lib/*
!/scratch-gui/src/lib/libraries
/scratch-gui/src/lib/libraries/*
!/scratch-gui/src/lib/libraries/extensions
/scratch-gui/src/lib/libraries/extensions/*
!/scratch-gui/src/lib/libraries/extensions/index.jsx
!/scratch-gui/src/lib/libraries/extensions/uiapduino

# 拡張機能一覧と接続モーダルの訳文を scratch-l10n のメッセージへ重ねる
!/scratch-gui/src/reducers
/scratch-gui/src/reducers/*
!/scratch-gui/src/reducers/locales.js

# 接続モーダルのバッジを拡張機能ごとに差し替えられるようにする
!/scratch-gui/src/containers
/scratch-gui/src/containers/*
!/scratch-gui/src/containers/connection-modal.jsx
!/scratch-gui/src/components
/scratch-gui/src/components/*
!/scratch-gui/src/components/connection-modal
/scratch-gui/src/components/connection-modal/*
!/scratch-gui/src/components/connection-modal/connected-step.jsx
!/scratch-gui/src/components/connection-modal/connecting-step.jsx

# WebHID の許可設定のため main プロセスにもパッチを当てる
/scratch-desktop/*
!/scratch-desktop/src
/scratch-desktop/src/*
!/scratch-desktop/src/main
/scratch-desktop/src/main/*
!/scratch-desktop/src/main/index.js
